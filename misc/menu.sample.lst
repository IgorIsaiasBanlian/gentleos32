# Config for GRUB Legacy
# To override, copy this file to misc/menu.lst
# For GRUB 2, and all the available options, see misc/grub.sample.cfg

set timeout=5
set default=0

title GentleOS/32
kernel /gentleos.bin

title GentleOS/32 (neon theme)
kernel /gentleos.bin theme=neon

title GentleOS/32 (mono theme)
kernel /gentleos.bin theme=mono

title GentleOS/32 (serial debug)
kernel /gentleos.bin uart=debug

title GentleOS/32 (serial mouse)
kernel /gentleos.bin uart=mouse
